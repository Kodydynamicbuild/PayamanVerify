{
  "builds": [
    { "src": "login.py", "use": "@vercel/python" },
    { "src": "callback.py", "use": "@vercel/python" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/login", "dest": "/login.py" },
    { "src": "/callback", "dest": "/callback.py" },
    { "src": "/", "dest": "/index.html" }
  ]
}
